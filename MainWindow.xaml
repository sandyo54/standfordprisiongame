<Window x:Class="standfordprisiongame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:standfordprisiongame"
        mc:Ignorable="d"
        Title="Stanford Prison Experiment" Height="450" Width="800">
    <Grid x:Name="Stanford_Prison_experiment_" Background="#1A1A1A">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#252525" Padding="20">

            <StackPanel>

                <TextBlock x:Name="StatusHeader" 
                       Text="SUBJECT STATUS: INITIALIZING..." 
                       Foreground="Gray" 
                       FontSize="10" 
                       Margin="0,0,0,5"/>
                
               
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Mental Stability" Foreground="White"/>
                        <ProgressBar x:Name="StabilityBar" Height="20" Value="100" Foreground="DarkCyan" Background="#333"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="Compliance Level" Foreground="White"/>
                        <ProgressBar x:Name="ComplianceBar" Height="20" Value="100" Foreground="Goldenrod" Background="#333"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Background="Black" BorderBrush="#444" BorderThickness="1" Margin="20,10">
            <ScrollViewer x:Name="LogScroller" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="LogText" 
                       TextWrapping="Wrap" 
                       Padding="15" 
                       Foreground="LightGray" 
                       FontFamily="Consolas" 
                       FontSize="14"
                       Text="[SYSTEM]: Subject #819 intake complete. Monitoring active..."/>
            </ScrollViewer>
        </Border>

        <UniformGrid Grid.Row="2" Columns="3" Margin="20,0,20,20">
            <Button x:Name="BtnObey" 
            Content="OBEY ORDERS" 
            Click="OnObeyClick" 
            Height="50" 
            Margin="5" 
            FontWeight="Bold"/>

            <Button x:Name="BtnRebel" 
            Content="REBEL" 
            Click="OnRebelClick" 
            Height="50" 
            Margin="5" 
            FontWeight="Bold"/>

            <Button x:Name="BtnEscape" 
            Content="ESCAPE ATTEMPT" 
            Click="OnEscapeClick" 
            Height="50" 
            Margin="5" 
            Background="DarkRed" 
            Foreground="White" 
            FontWeight="Bold"/>
        </UniformGrid>

        <Grid x:Name="TitleScreen" Grid.RowSpan="3" Background="#0A0A0A">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                <TextBlock Text="STANFORD UNIVERSITY" Foreground="#8C1515" 
                       FontSize="14" HorizontalAlignment="Center" FontWeight="Bold"/>
                <TextBlock Text="DEPARTMENT OF PSYCHOLOGY" Foreground="Gray" 
                       FontSize="10" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <TextBlock Text="THE PRISON EXPERIMENT" Foreground="White" 
                       FontSize="48" FontWeight="ExtraBold" HorizontalAlignment="Center"/>

                <TextBlock Text="August 14, 1971" Foreground="#444" 
                       FontSize="18" HorizontalAlignment="Center" Margin="0,5,0,40"/>

                <Border BorderBrush="#333" BorderThickness="1" Padding="20" MaxWidth="500">
                    <TextBlock x:Name="DisclaimerText" 
               Text="Accessing Stanford Department of Psychology database... Calculating assignment..." 
               Foreground="LightGray" 
               TextWrapping="Wrap" 
               TextAlignment="Center" 
               FontStyle="Italic"/>
                </Border>

                <Button Content="BEGIN SIMULATION" Click="OnStartGameClick" 
                    Width="200" Height="50" Margin="0,40,0,0" 
                    Background="#8C1515" Foreground="White" BorderThickness="0"
                    FontSize="16" FontWeight="Bold"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
